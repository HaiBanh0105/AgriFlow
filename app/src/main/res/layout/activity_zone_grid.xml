<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".ui.activity.ZoneGridActivity">

    <!-- Top AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        app:elevation="2dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/colorOnSurface"
            app:title="Sơ đồ lưới"
            app:titleTextColor="@color/colorOnSurface" />

        <!-- Health Status Summary Bar (Clickable to select all of status) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorSurfaceVariant"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_pill_healthy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_badge"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/status_healthy"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="🟢 68 Khỏe mạnh" />

                <TextView
                    android:id="@+id/tv_pill_warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_badge"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/status_warning"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="🟡 5 Cần chăm sóc" />

                <TextView
                    android:id="@+id/tv_pill_diseased"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_badge"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/status_diseased"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="🔴 2 Sâu bệnh" />

                <TextView
                    android:id="@+id/tv_pill_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_badge"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/status_empty"
                    android:textSize="12sp"
                    tools:text="⚪ 5 Trống" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Harvest Cycle Filters Bar -->
        <HorizontalScrollView
            android:id="@+id/scroll_harvest_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorSurfaceVariant"
            android:paddingStart="12dp"
            android:paddingTop="2dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_filter_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_badge"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="🌴 Tất cả"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_filter_due"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_badge"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="⏳ Đến kỳ thu hoạch"
                    android:textColor="#C62828"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_filter_recent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_badge"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="🕒 Vừa thu (&lt;15d)"
                    android:textColor="#0277BD"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_filter_never"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_badge"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="❓ Chưa thu"
                    android:textColor="#546E7A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Active Multi-Select Mode Notification Banner -->
        <LinearLayout
            android:id="@+id/layout_multi_select_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E3F2FD"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_check_box"
                app:tint="#1976D2" />

            <TextView
                android:id="@+id/tv_mode_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Chế độ chọn nhiều"
                android:textColor="#0D47A1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Selector: Tap vs Brush -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_group_select_mode"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                app:checkedButton="@id/btn_mode_tap"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_tap"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="👆 Chạm"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_brush"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="🖌️ Quét"
                    android:textSize="11sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_exit_multi_select"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="✕ Thoát"
                android:textColor="#D32F2F"
                android:textSize="11sp" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Grid Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Interactive Custom Canvas Grid View -->
        <com.example.agriflow.ui.view.FarmGridView
            android:id="@+id/farm_grid_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating Zoom & Fit Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_zoom_in"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Phóng to"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_zoom_in"
                app:tint="@color/colorOnSurface" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_zoom_out"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="Thu nhỏ"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_zoom_out"
                app:tint="@color/colorOnSurface" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_fit_screen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="Căn giữa màn hình"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_fit_screen"
                app:tint="@color/colorOnSurface" />

        </LinearLayout>

        <!-- Bulk Action Floating Panel at Bottom -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_bulk_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/colorSurface"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/dividerColor"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Header of Selection: count and helper buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_selected_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Đã chọn 8 ô" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_select_all"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="Tất cả"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_invert_selection"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="Đảo"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear_selection"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="Bỏ chọn"
                        android:textColor="@color/status_diseased"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Bulk Action Buttons - Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_bulk_water"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="Tưới"
                        android:textColor="@color/action_water"
                        app:icon="@drawable/ic_water"
                        app:iconGravity="textStart"
                        app:iconTint="@color/action_water" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_bulk_fertilize"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:text="Bón phân"
                        android:textColor="@color/action_fertilize"
                        app:icon="@drawable/ic_fertilizer"
                        app:iconGravity="textStart"
                        app:iconTint="@color/action_fertilize" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_bulk_pesticide"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Trừ sâu"
                        android:textColor="@color/action_pesticide"
                        app:icon="@drawable/ic_bug"
                        app:iconGravity="textStart"
                        app:iconTint="@color/action_pesticide" />

                </LinearLayout>

                <!-- Bulk Action Buttons - Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_bulk_harvest"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="Thu hoạch"
                        android:textColor="@color/action_harvest"
                        app:icon="@drawable/ic_harvest"
                        app:iconGravity="textStart"
                        app:iconTint="@color/action_harvest" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_bulk_plant"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:text="Gieo giống"
                        android:textColor="@color/colorPrimary"
                        app:icon="@drawable/ic_sprout"
                        app:iconGravity="textStart"
                        app:iconTint="@color/colorPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_bulk_status"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Đổi TT"
                        android:textColor="@color/colorOnSurface"
                        app:icon="@drawable/ic_check"
                        app:iconGravity="textStart"
                        app:iconTint="@color/colorOnSurface" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
